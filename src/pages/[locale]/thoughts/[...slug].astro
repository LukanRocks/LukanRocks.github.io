---
import { render } from 'astro:content';
import BaseLayout from '../../../components/layout/BaseLayout.astro';
import Breadcrumbs from '../../../components/content/Breadcrumbs.astro';
import ThoughtMeta from '../../../components/content/ThoughtMeta.astro';
import ThoughtLicense from '../../../components/content/ThoughtLicense.astro';
import ThoughtNavigation from '../../../components/content/ThoughtNavigation.astro';
import RelatedThoughts from '../../../components/content/RelatedThoughts.astro';
import { contentTypes } from '../../../config/content';
import { getLocalePath, locales, type Locale } from '../../../config/i18n';
import { siteConfig } from '../../../config/site';
import { adjacentEntries, getLocalizedEntries, entrySlug, relatedThoughts, seriesThoughts } from '../../../lib/content/entries';

export async function getStaticPaths() {
  const paths = [];
  for (const locale of locales.filter((item) => item !== 'en')) {
    const thoughts = await getLocalizedEntries('thoughts', locale);
    paths.push(...thoughts.map((entry) => ({ params: { locale, slug: entrySlug(entry as any) }, props: { entry, locale } })));
  }
  return paths;
}

const { entry, locale } = Astro.props as any as { entry: any; locale: Locale };
const { Content, headings } = await render(entry);
const thoughts = await getLocalizedEntries('thoughts', locale);
const adjacent = adjacentEntries<'thoughts'>(thoughts, entry);
const related = relatedThoughts(thoughts, entry, siteConfig.thought.relatedCount);

const seriesEntries = entry.data.series?.length ? await getLocalizedEntries('series', locale) : [];
const seriesGroups = (entry.data.series ?? [])
  .map((slug: string) => {
    const seriesEntry = seriesEntries.find((s) => entrySlug(s as any) === slug);
    return seriesEntry ? { seriesEntry, thoughts: seriesThoughts(thoughts, slug) } : undefined;
  })
  .filter((group: unknown): group is { seriesEntry: any; thoughts: any[] } => Boolean(group));
---

<BaseLayout title={entry.data.title} description={entry.data.description} locale={locale} headings={headings} toc={entry.data.toc ?? 'center'}>
  <Breadcrumbs
    locale={locale}
    items={[
      { label: siteConfig.shortName, href: getLocalePath(locale, '/'), icon: 'lucide:home' },
      { label: contentTypes.thoughts.label[locale], href: getLocalePath(locale, contentTypes.thoughts.path), icon: contentTypes.thoughts.icon },
      { label: entry.data.title, icon: 'lucide:file-text' }
    ]}
  />
  {entry.data.cover && (
    <div class="mb-8 overflow-hidden rounded-[var(--radius-card)]">
      <img src={entry.data.cover} alt={entry.data.title} class="aspect-video max-h-[60vh] w-full object-cover" loading="eager" />
    </div>
  )}
  <ThoughtMeta
    title={entry.data.title}
    description={entry.data.description}
    date={entry.data.pubDate}
    locale={locale}
    tags={entry.data.tags}
    seriesGroups={seriesGroups}
    current={entry}
  />
  <article class="prose mb-12 max-w-none">
    <Content />
  </article>
  <ThoughtLicense locale={locale} />
  <ThoughtNavigation previous={adjacent.previous} next={adjacent.next} locale={locale} />
  <RelatedThoughts thoughts={related} locale={locale} />
</BaseLayout>
