---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import EntryList from '../../components/content/EntryList.astro';
import PageHeader from '../../components/content/PageHeader.astro';
import { getLocalizedEntries } from '../../lib/content/entries';
import { useTranslations } from '../../i18n/utils';

const locale = 'en';
const thoughts = await getLocalizedEntries('thoughts', locale);
const t = useTranslations(locale);
---

<BaseLayout title={t('thoughts.title')} description={t('thoughts.description')} locale={locale}>
  <PageHeader title={t('thoughts.title')} description={t('thoughts.description')} locale={locale} />
  <EntryList entries={thoughts} collection="thoughts" locale={locale} />
</BaseLayout>
