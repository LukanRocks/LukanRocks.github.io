---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import EntryList from '../../components/content/EntryList.astro';
import PageHeader from '../../components/content/PageHeader.astro';
import { getLocalizedEntries, seriesThoughts, entrySlug } from '../../lib/content/entries';

export async function getStaticPaths() {
  const series = await getLocalizedEntries('series', 'en');
  const thoughts = await getLocalizedEntries('thoughts', 'en');
  return series.map((entry) => ({
    params: { series: entrySlug(entry as any) },
    props: { seriesEntry: entry, thoughts: seriesThoughts(thoughts, entrySlug(entry as any)) }
  }));
}

const { seriesEntry, thoughts } = Astro.props;
---

<BaseLayout title={seriesEntry.data.title} description={seriesEntry.data.description} locale="en">
  <PageHeader title={seriesEntry.data.title} description={seriesEntry.data.description} locale="en" />
  <EntryList entries={thoughts} collection="thoughts" locale="en" />
</BaseLayout>
