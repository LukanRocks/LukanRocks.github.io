---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../../config/i18n';
import { useTranslations } from '../../i18n/utils';

interface Props {
  items: CollectionEntry<'libraryEmojis'>[];
  locale: Locale;
}

const { items, locale } = Astro.props;
const t = useTranslations(locale);

const fileName = (src: string) => src.split('/').pop() || 'emoji';
---

{items.length === 0 ? (
  <p class="text-muted-foreground">{t('library.empty')}</p>
) : (
  <ul class="grid grid-cols-4 gap-3 sm:grid-cols-6 md:grid-cols-8">
    {items.map((item) => (
      <li class="group relative flex flex-col items-center gap-1.5">
        <button
          type="button"
          data-copy={item.data.shortcode}
          data-toast={`${t('library.copied')} ${item.data.shortcode}`}
          title={`${t('library.copyHint')} — ${item.data.shortcode}`}
          aria-label={`${item.data.name} — ${t('library.copyHint')} ${item.data.shortcode}`}
          class="grid aspect-square w-full cursor-copy place-items-center rounded-[var(--radius-control)] border border-border bg-muted p-2.5 transition hover:border-primary/40 hover:bg-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/50"
        >
          <img src={item.data.src} alt={item.data.name} loading="lazy" decoding="async" class="max-h-full max-w-full object-contain" />
        </button>
        <span class="w-full truncate text-center text-[0.7rem] leading-tight text-muted-foreground" title={item.data.shortcode}>{item.data.shortcode}</span>
        <a
          href={item.data.src}
          download={fileName(item.data.src)}
          title={t('library.download')}
          aria-label={`${t('library.download')} ${item.data.name}`}
          class="absolute right-1 top-1 grid h-6 w-6 place-items-center rounded-full bg-black/55 text-white opacity-0 backdrop-blur transition hover:bg-black/75 focus-visible:opacity-100 group-hover:opacity-100"
        >
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12"/><path d="m7 10 5 5 5-5"/><path d="M5 21h14"/></svg>
        </a>
      </li>
    ))}
  </ul>
)}
