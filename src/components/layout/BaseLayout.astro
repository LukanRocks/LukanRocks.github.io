---
import '../../styles/global.css';
import { localeMeta, type Locale } from '../../config/i18n';
import { siteConfig } from '../../config/site';
import Header from './Header.astro';
import Footer from './Footer.astro';
import Dock from '../ui/Dock.astro';
import SearchModal from '../features/SearchModal.astro';
import Toc from '../features/Toc.astro';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title?: string;
  description?: string;
  locale?: Locale;
  headings?: Heading[];
  toc?: boolean | 'center' | 'side';
}

const {
  locale = 'en',
  title = siteConfig.meta.title,
  description = siteConfig.meta.description[locale],
  headings = [],
  toc = false
} = Astro.props;

const pageTitle = title === siteConfig.meta.title ? title : `${title} | ${siteConfig.meta.title}`;
const htmlLang = localeMeta[locale].htmlLang;
const assetBase = import.meta.env.BASE_URL || '/';
const faviconBase = assetBase.replace(/\/?$/, '/');
const faviconLight = `${faviconBase}favicon-light.png`;
const faviconDark = `${faviconBase}favicon-dark.png`;
const themeInit = `
(() => {
  const root = document.documentElement;
  const mode = localStorage.getItem('color-mode');
  const isDark = mode === 'dark' || (!mode && window.matchMedia('(prefers-color-scheme: dark)').matches);
  if (isDark) root.classList.add('dark');
  const icon = document.getElementById('favicon');
  if (icon) icon.setAttribute('href', isDark ? '${faviconDark}' : '${faviconLight}');
})();
`;
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" id="favicon" href={faviconLight} />
    <title>{pageTitle}</title>
    <script is:inline set:html={themeInit}></script>
  </head>
  <body class="bg-background text-foreground min-h-screen antialiased">
    <main class="mx-auto min-h-screen w-full px-4" style={`--layout-content-width: ${siteConfig.ui.contentWidth}; max-width: var(--layout-content-width)`}>
      <Header locale={locale} />
      <slot />
      <Footer locale={locale} />
    </main>
    {toc && headings.length > 0 && <Toc headings={headings} position={toc === true ? 'center' : toc} />}
    {siteConfig.ui.dock.enabled && <Dock locale={locale} />}
    <SearchModal locale={locale} />
    <script>
      import '../../scripts/theme-controls.ts';
      import '../../scripts/reading-progress.ts';
      import '../../scripts/search.ts';
      import '../../scripts/toc.ts';
      import '../../scripts/gallery.ts';
      import '../../scripts/library.ts';
      import '../../scripts/mermaid.ts';
      import '../../scripts/dock.ts';
      import '../../scripts/tabs.ts';
    </script>
  </body>
</html>
